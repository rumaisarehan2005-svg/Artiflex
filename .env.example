# MongoDB Connection URI (e.g., MongoDB Atlas for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/artifex?retryWrites=true&w=majority

# NextAuth Configuration
# Run `openssl rand -base64 32` to generate a secure secret
NEXTAUTH_SECRET=placeholder_nextauth_secret_minimum_32_characters_long
# Set this to your Hugging Face space direct URL (e.g., https://username-spacename.hf.space)
NEXTAUTH_URL=https://<your-huggingface-space-subdomain>.hf.space

# Backend Security Configurations
# Secret token to authenticate Next.js API requests to FastAPI backend
# Run `openssl rand -hex 32` to generate a secure token
BACKEND_SECRET_TOKEN=placeholder_random_hex_string_for_backend_security_validation

# FastAPI Backend URL (only needed if Next.js needs to reach a remote FastAPI server)
# In standard local/co-located docker environments, this defaults internally to http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# Pollinations AI Image Generation
# Get your secret key (sk_) from https://enter.pollinations.ai
# Secret keys have no rate limits and must never be exposed to the client
POLLINATIONS_API_KEY=sk_your_pollinations_secret_key_here

# Hugging Face Free API Key (Free Alternative - get from https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=hf_your_huggingface_free_token_here

# Backend FastAPI Configuration
HOST=0.0.0.0
PORT=7860
